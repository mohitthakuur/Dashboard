{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "photoURL": { "type": "string" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "Project": {
      "title": "Project",
      "description": "A container for tasks and team members",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId"]
    },
    "Member": {
      "title": "Member",
      "description": "Relationship between a user and a project",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["Admin", "Member"] },
        "joinedAt": { "type": "string", "format": "date-time" },
        "email": { "type": "string" }
      },
      "required": ["role", "email"]
    },
    "Task": {
      "title": "Task",
      "description": "A specific item of work within a project",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["Todo", "In Progress", "Review", "Done"] },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
        "assigneeId": { "type": "string" },
        "dueDate": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "status", "priority", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile records"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Projects managed by teams"
    },
    "/projects/{projectId}/members/{userId}": {
      "schema": "Member",
      "description": "Members assigned to a project"
    },
    "/projects/{projectId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks associated with a project"
    }
  }
}
